{
  "name": "qtgs-cursor-script",
  "private": true,
  "description": "Cursor rules/skills sync — playbook to .cursor/",
  "scripts": {
    "sync:rule": "node sync-cursor.mjs --only rules",
    "sync:skill": "node sync-cursor.mjs --only skills",
    "sync:rule:dry": "node sync-cursor.mjs --only rules --dry-run",
    "sync:skill:dry": "node sync-cursor.mjs --only skills --dry-run",
    "sync:rule:check": "node sync-cursor.mjs --only rules --check-clean --dry-run",
    "sync:skill:check": "node sync-cursor.mjs --only skills --check-clean --dry-run"
  }
}
